# OIDC (Authorization Code + PKCE). Tokens come from your external IdP; the API only verifies them.
# Copy to .env.local (git-ignored). All VITE_* values are public: never put secrets here.

# Issuer URL (must serve /.well-known/openid-configuration). Required.
VITE_OIDC_AUTHORITY=https://idp.example.com/
# Public SPA client id registered at the IdP (no client secret). Required.
VITE_OIDC_CLIENT_ID=acgs-enterprise-manager-spa
# Defaults to <origin>/callback. Must match the IdP's allowed redirect URIs exactly.
# VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback
# Defaults to <origin>/login. Must be an allowed post-logout redirect URI at the IdP.
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
# Defaults to "openid profile email". Add offline_access if the IdP needs it to issue refresh tokens.
# VITE_OIDC_SCOPE=openid profile email offline_access
# Optional: API audience, sent as an extra "audience" authorize param (Auth0, etc.).
# Must equal the audience the backend validates.
# VITE_OIDC_AUDIENCE=https://api.acgs.example.com
