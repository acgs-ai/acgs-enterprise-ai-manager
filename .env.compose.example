# Docker Compose environment template for ACGS Enterprise Manager.
# Copy to .env before running `docker compose up --build`:
#   cp .env.compose.example .env
#
# Full OIDC / JWT configuration documentation:
#   - Backend JWT verification: .env.example
#   - Frontend OIDC (PKCE) build args: frontend/.env.example

# PostgreSQL (dev defaults; replace POSTGRES_PASSWORD outside local dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=acgs_manager

# Host port bindings (defaults shown)
API_PORT=8001
FRONTEND_PORT=3000

# Backend interactive docs (/docs, /redoc, /openapi.json). Default false (fail-closed).
API_DOCS_ENABLED=false

# Backend external IdP JWT verification (leave blank for fail-closed smoke test:
# /health and / return 200; /api/v1/* returns 503 until configured).
# Set exactly one of AUTH_JWKS_URL or AUTH_JWT_KEY when enabling auth.
# Example: AUTH_JWT_ISSUER=https://idp.example.com/
AUTH_JWT_ISSUER=
# Example: AUTH_JWT_AUDIENCE=acgs-enterprise-manager
AUTH_JWT_AUDIENCE=
AUTH_JWT_ALGORITHMS=RS256
# Example: AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
AUTH_JWKS_URL=
# AUTH_JWT_KEY=
AUTH_ROLE_CLAIM=role

# Frontend OIDC SPA settings (baked into the Vite bundle + CSP meta tag at build time;
# rebuild frontend after changes with: docker compose up -d --build frontend)
# Example: VITE_OIDC_AUTHORITY=https://idp.example.com/
VITE_OIDC_AUTHORITY=
# Example: VITE_OIDC_CLIENT_ID=acgs-enterprise-manager-spa
VITE_OIDC_CLIENT_ID=
# VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
# VITE_OIDC_SCOPE=openid profile email
# VITE_OIDC_AUDIENCE=
