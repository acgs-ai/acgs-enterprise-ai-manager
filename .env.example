# Authentication: bearer JWTs issued by an EXTERNAL identity provider.
# This API only verifies tokens; it has no login endpoint and mints nothing.
# If any required value is missing or unsafe, every protected route returns
# 503 {"detail": "Authentication not configured"} (no default key exists).
# Public without a token: /health and / (plus the docs paths below if enabled).

# Required: expected "iss" and "aud" claims. AUTH_JWT_AUDIENCE must be the
# API's audience and must never appear in an ID token's "aud" (so not the SPA
# client id), otherwise ID tokens would be accepted as access tokens.
AUTH_JWT_ISSUER=https://idp.example.com/
AUTH_JWT_AUDIENCE=acgs-enterprise-manager

# Comma-separated allowlist (default RS256). "none" is rejected, and HS*
# cannot be mixed with asymmetric algorithms (key confusion).
AUTH_JWT_ALGORITHMS=RS256

# Key material: set exactly ONE of the two.
# Preferred: the IdP's JWKS endpoint (https only, keys cached for 5 minutes,
# 5 s fetch timeout; an unknown kid triggers at most one refetch per 60 s).
AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# Or: a PEM public key for RS*/PS*/ES*/EdDSA, or a shared secret of at least
# 32 bytes for HS*.
# AUTH_JWT_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"

# Claim holding the role (admin > manager > user > viewer). Missing or
# unknown roles map to "viewer". Default: role
# The IdP must put this claim in the ACCESS token (not only the ID token), as a
# single top-level string with an exact lowercase value, e.g. "manager".
# "Admin", ["admin"], null or a nested claim all count as "viewer" (still
# signed in, read-only). Invalid tokens are rejected with 401, never viewer.
# Derive the value from an admin-controlled app role or group assignment,
# never from a user-editable profile field. A namespaced top-level name
# (e.g. https://example.com/role) is fine: put the exact name here.
AUTH_ROLE_CLAIM=role

# Interactive API docs. Default false (fail-closed): /docs, /redoc and
# /openapi.json are not served and need a token like any other path.
# Set to true only where exposing the API schema is acceptable. Read at startup.
API_DOCS_ENABLED=false
